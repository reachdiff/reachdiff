.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Real plans, scans and reports (contain sensitive workspace metadata)
local/

# Temporary live-session overrides (P6)
validation/azure/terraform/*_override.tf

# Promotion material (PR, social media drafts): private, never pushed
promo/
press/
social/
